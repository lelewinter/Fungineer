# Local SQLite path (optional; defaults to ./fungineer.db when unset)
FUNGINEER_DB=fungineer.db

# Production frontend origin (added to CORS allowlist on top of localhost).
# Example for Cloudflare Pages:
#   FRONTEND_URL=https://fungineer.pages.dev
FRONTEND_URL=

# Set automatically by Railway in production; leave empty locally to use --port flag.
# PORT=8000
